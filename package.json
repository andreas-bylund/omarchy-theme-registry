{
  "name": "omarchy-theme-registry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Community index of Omarchy themes, published as a static JSON feed.",
  "license": "MIT",
  "author": "Andreas Bylund",
  "homepage": "https://omarchythemes.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreas-bylund/omarchy-theme-registry.git"
  },
  "bugs": {
    "url": "https://github.com/andreas-bylund/omarchy-theme-registry/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node src/validate.js",
    "build": "node src/build.js --out dist --cache .cache",
    "crawl": "node src/crawl.js",
    "crawl:write": "node src/crawl.js --write"
  },
  "dependencies": {
    "sharp": "^0.35.0",
    "smol-toml": "^1.4.2"
  }
}
